.archive-article-descript
  flex-grow 1
  width 61.8%
  color text-color
  line-height 1.8
  @extend $block-caption
.archive-article-footer
  margin-top: 1.5rem

.archive-article-inner
  .article-tag-list
    padding 0
    margin 0